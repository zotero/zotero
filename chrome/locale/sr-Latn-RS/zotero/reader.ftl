    { -app-name } je pronašao { $count ->
        [one] { $count } { $tool } napomenu
        [few] { $count } { $tool } napomene
       *[other] { $count } { $tool } napomena
    }, poslednji put izmenjeno { $lastModifiedRelative }.
    
