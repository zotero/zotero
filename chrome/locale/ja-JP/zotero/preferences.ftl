preferences-sync-data-syncing-heading = { -preferences-sync-data-syncing }
preferences-sync-data-syncing-description = { -app-name } アカウントでログインすると、デバイス間でデータを同期したり、他のユーザーと共同作業を行ったりすることができます。
preferences-sync-settings-heading = 同期
preferences-sync-settings-intro = { -app-name } は、デバイス間でライブラリのデータやファイルを同期できます。 <label data-l10n-name="sync-link">詳細情報</label>
preferences-sync-reset-heading = 同期のリセット
